    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# load\n",
    "arr = np.load(\"timestamps.npy\")\n",
    "\n",
    "# histogram\n",
    "plt.hist(arr, bins=30, edgecolor=\"black\")   # adjust bins as needed\n",
    "plt.xlabel(\"Value\")\n",
    "plt.ylabel(\"Count\")\n",
    "plt.title(\"Histogram\")\n",
    "plt.show()"
   ]
  }
